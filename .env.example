# ==============================================================================
# Google Gemini Multimodal AI Configuration
# ==============================================================================
GEMINI_API_KEY=your_gemini_api_key_here

# ==============================================================================
# SMTP Email Dispatch Settings (Gmail / Custom Relay)
# ==============================================================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_specific_password_here
DEFAULT_FROM_EMAIL=Digital Public Infrastructure Portal <your_email@gmail.com>
NOTIFICATION_FALLBACK_EMAIL=your_email@gmail.com

# ==============================================================================
# Django Security & Core Settings
# ==============================================================================
DJANGO_SECRET_KEY=your_secure_django_secret_key_here
DEBUG=True
ALLOWED_HOSTS=*
USE_SQLITE=true
